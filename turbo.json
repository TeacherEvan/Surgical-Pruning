{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env*"]
}
