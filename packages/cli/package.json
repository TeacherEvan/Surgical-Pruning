{
  "name": "@surgical-pruning/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "surgical-pruning": "dist/index.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@surgical-pruning/core": "workspace:*",
    "@surgical-pruning/reviewer": "workspace:*",
    "@surgical-pruning/researcher": "workspace:*",
    "@surgical-pruning/planner": "workspace:*",
    "@surgical-pruning/executor": "workspace:*",
    "@surgical-pruning/verifier": "workspace:*",
    "@surgical-pruning/debriefer": "workspace:*",
    "@surgical-pruning/auditor": "workspace:*",
    "@surgical-pruning/researcher-v2": "workspace:*",
    "execa": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TeacherEvan/Surgical-Pruning.git"
  }
}
